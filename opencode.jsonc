{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  // Don't share sessions with others automatically
  "share": "manual",
  "default_agent": "plan",
  "agent": {
    // Some models don't need to be running OPUS al the time.
    // I could hard-code here, but i use the same config files on different machines
    // and some of those machines have access to work-provided AI providers.
    // set "[provider]/claude-sonnet-4.6" for fast and claude-opus-4.6 as the big model
    "dev/explore": {
      "model": "{env:OPENCODE_FAST_MODEL}"
    },
    "dev/review": {
      "model": "{env:OPENCODE_BIG_MODEL}"
    },
    "dev/security-auditor": {
      "model": "{env:OPENCODE_BIG_MODEL}"
    },
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.5-27b-fast": {
          "name": "Qwen3.5 27B Q4_K_M (fast)",
          "id": "Qwen3.5-27B-Q4_K_M.gguf",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3.5-27b-think": {
          "name": "Qwen3.5 27B Q4_K_M (think)",
          "id": "Qwen3.5-27B-Q4_K_M.gguf",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "low"
          }
        },
        "qwen3.5-4b-fast": {
          "name": "Qwen3.5 4B Q8_0 (fast)",
          "id": "Qwen3.5-4B-Q8_0.gguf",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3.5-4b-think": {
          "name": "Qwen3.5 4B Q8_0 (think)",
          "id": "Qwen3.5-4B-Q8_0.gguf",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gemma4-fast": {
          "name": "Gemma4 26B MXFP4_MOE (fast)",
          "id": "gemma-4-26B-A4B-it-MXFP4_MOE.gguf",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gemma4-think": {
          "name": "Gemma4 26B MXFP4_MOE (think)",
          "id": "gemma-4-26B-A4B-it-MXFP4_MOE.gguf",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.2-codex": {
          "name": "GPT 5.2 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex-max": {
          "name": "GPT 5.1 Codex Max (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex": {
          "name": "GPT 5.1 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex-mini": {
          "name": "GPT 5.1 Codex Mini (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1": {
          "name": "GPT 5.1 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "low"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "high"
            }
          }
        }
      }
    },
    "kiro": {
      "npm": "kiro-ai-provider",
      "name": "Kiro",
      "models": {
        "claude-opus-4.7": {
          "name": "Claude Opus 4.7",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "auto": {
          "name": "Kiro Auto",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "Notion_*": "ask",
    "Sanity_*": "ask",
    "chrome-devtools_*": "ask",
    "context7_*": "ask",
    "github_*": "ask"
  },
  "mcp": {
    "aws-knowledge-mcp-server": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": false
    },
    // https://github.com/paulburgess1357/nvim-mcp
    "nvim-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "nvim-mcp"
      ],
      "enabled": false
    },
    "calculator": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "peva-calculator-mcp:latest"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "confluence": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "--env",
        "CONFLUENCE_DEFAULT_SPACE={env:CONFLUENCE_DEFAULT_SPACE}",
        "--env",
        "CONFLUENCE_BASE_URL={env:CONFLUENCE_BASE_URL}",
        "--env",
        "CONFLUENCE_TOKEN={env:CONFLUENCE_TOKEN}",
        "--env",
        "CONFLUENCE_ALLOW_MUTATIONS=true",
        "peva-atlassian-mcp:latest"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "peva-fetch-mcp:latest"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    },
    // This plugin is extremely dangerous to use
    // grep.app does not sort searces in any curated/popular/etc. way
    // last time i checked searching for "svelte" only gave real svelte docs at result #11
    // It will output ANY code snippets, including obvious LLM injection traps (result #4 when looking for svelte)
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "jira": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "--env",
        "JIRA_ALLOW_MUTATIONS=true",
        "--env",
        "JIRA_BASE_URL={env:JIRA_BASE_URL}",
        "--env",
        "JIRA_TOKEN={env:JIRA_TOKEN}",
        "peva-jira-mcp:latest"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-knowledge-graph",
        "--memory-path",
        "{env:AIM_GLOBAL_PATH}"
      ]
    },
    "notion": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--env",
        "NOTION_API_TOKEN={env:NOTION_API_TOKEN}",
        "peva-notion-mcp:latest"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "sanity": {
      "type": "remote",
      "url": "https://mcp.sanity.io",
      "headers": {
        "Authorization": "Bearer {env:SANITY_MCP_TOKEN}"
      },
      "enabled": false
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "peva-sequentialthinking-mcp:latest"
      ]
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": false
    },
    "time": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "peva-time-mcp:latest"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "opencode-openai-codex-auth"
  ]
}
