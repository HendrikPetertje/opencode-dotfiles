{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "instructions": [
    "AGENTS.md"
  ],
  // Don't share sessions with others automatically
  "share": "manual",
  "default_agent": "plan",
  "agents": {
    // Some models don't need to be running OPUS al the time.
    // I could hard-code here, but i use the same config files on different machines
    // and some of those machines have access to work-provided AI providers.
    // set "[provider]/claude-sonnet-4.6" for fast and claude-opus-4.6 as the big model
    "dev/explore": {
      "model": "{env:OPENCODE_FAST_MODEL}"
    },
    "dev/review": {
      "model": "{env:OPENCODE_BIG_MODEL}"
    },
    "dev/security-auditor": {
      "model": "{env:OPENCODE_BIG_MODEL}"
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "opencode",
        "effect": "deny"
      }
    ]
  },
  "providers": {
    "lmstudio": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LM Studio (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B (LM Studio)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 120000,
            "output": 8192
          }
        }
      }
    },
    "anthropic": {
      "settings": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "openai": {
      "settings": {
        // "apiKey": "{env:OPENAI_API_KEY}",
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "notion_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "sanity_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "chrome_devtools_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "github_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "obsidian_*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "opencode-kiro@0.5.0-beta.7",
    // Memory MCP + footer widget. `globalPath` is where global .aim memory lives (default ~/.aim).
    {
      "package": "./configured-plugins/memory-ticker",
      "options": {
        "globalPath": "~/.config/.aim"
      }
    },
    // Opt-in OS sandbox for the agent's shell, per project. See configured-plugins/sandbox-mode/README.md.
    {
      "package": "./configured-plugins/sandbox-mode",
      "options": {
        "credentialPaths": [
          "~/.ssh",
          "~/.aws",
          "~/.azure",
          "~/.config/gcloud",
          "~/.config/gh",
          "~/.gnupg",
          "~/.docker/config.json",
          "~/.kube",
          "~/.netrc",
          "~/.npmrc",
          "~/.git-credentials",
          "~/.local/share/opencode/auth.json",
          "~/.dotfiles/tmux-envs"
        ]
      }
    },
    // Claude Code style auto mode: a reviewer model approves/denies permission checks. See configured-plugins/auto-mode/README.md.
    {
      "package": "./configured-plugins/auto-mode",
      "options": {
        "model": "github-copilot/claude-haiku-5.5",
        "memoryDir": "~/.config/.aim",
        "includeAgentsMd": false
      }
    }
  ],
  "mcp": {
    "servers": {
      "aws-knowledge-mcp-server": {
        "type": "remote",
        "url": "https://knowledge-mcp.global.api.aws",
        "disabled": true
      },
      // https://github.com/paulburgess1357/nvim-mcp
      "nvim-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "nvim-mcp"
        ],
        "disabled": true
      },
      "calculator": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "-i",
          "--rm",
          "peva-calculator-mcp:latest"
        ],
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "cd \"$HOME\" && if [ -n \"$CHROME_PATH\" ]; then exec \"$@\" --executablePath \"$CHROME_PATH\" --headless --isolated --chromeArg=--no-sandbox; else exec \"$@\"; fi",
          "sh",
          "npx",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true
      },
      "confluence": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "--env",
          "CONFLUENCE_DEFAULT_SPACE={env:CONFLUENCE_DEFAULT_SPACE}",
          "--env",
          "CONFLUENCE_BASE_URL={env:CONFLUENCE_BASE_URL}",
          "--env",
          "CONFLUENCE_TOKEN={env:CONFLUENCE_TOKEN}",
          "--env",
          "CONFLUENCE_ALLOW_MUTATIONS=true",
          "peva-atlassian-mcp:latest"
        ],
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
        "disabled": true
      },
      "fetch": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "peva-fetch-mcp:latest"
        ],
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "disabled": true
      },
      // This plugin is extremely dangerous to use
      // grep.app does not sort searces in any curated/popular/etc. way
      // last time i checked searching for "svelte" only gave real svelte docs at result #11
      // It will output ANY code snippets, including obvious LLM injection traps (result #4 when looking for svelte)
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": true
      },
      "jira": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "--env",
          "JIRA_ALLOW_MUTATIONS=true",
          "--env",
          "JIRA_BASE_URL={env:JIRA_BASE_URL}",
          "--env",
          "JIRA_TOKEN={env:JIRA_TOKEN}",
          "peva-jira-mcp:latest"
        ],
        "disabled": true
      },
      "notion": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "--env",
          "NOTION_TOKEN={env:NOTION_API_TOKEN}",
          "peva-notion-mcp:latest"
        ],
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "cd \"$HOME\" && exec \"$@\"",
          "sh",
          "npx",
          "@playwright/mcp@latest"
        ],
        "disabled": true
      },
      "sanity": {
        "type": "remote",
        "url": "https://mcp.sanity.io",
        "headers": {
          "Authorization": "Bearer {env:SANITY_MCP_TOKEN}"
        },
        "disabled": true
      },
      "sequentialthinking": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "peva-sequentialthinking-mcp:latest"
        ],
        "disabled": true
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
        "disabled": true
      },
      "obsidian": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "--env",
          "OBSIDIAN_API_KEY={env:OBSIDIAN_API_KEY}",
          "peva-obsidian-mcp:latest"
        ],
        "disabled": true
      },
      "time": {
        "type": "local",
        "command": [
          "podman",
          "run",
          "--rm",
          "-i",
          "peva-time-mcp:latest"
        ],
        "disabled": true
      }
    }
  }
}
