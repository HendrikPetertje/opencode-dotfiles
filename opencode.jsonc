{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md"
  ],
  "server": {
    "port": 4096
  },
  // Don't share sessions with others automatically
  "share": "manual",
  "default_agent": "plan",
  "lsp": true,
  "agent": {
    // Some models don't need to be running OPUS al the time.
    // I could hard-code here, but i use the same config files on different machines
    // and some of those machines have access to work-provided AI providers.
    // set "[provider]/claude-sonnet-4.6" for fast and claude-opus-4.6 as the big model
    "dev/explore": {
      "model": "{env:OPENCODE_FAST_MODEL}"
    },
    "dev/review": {
      "model": "{env:OPENCODE_BIG_MODEL}"
    },
    "dev/security-auditor": {
      "model": "{env:OPENCODE_BIG_MODEL}"
    },
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen 3.6 27B (LM Studio)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 120000,
            "output": 8192
          }
        },
        "gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B A4B (LM Studio)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 120000,
            "output": 8192
          }
        },
        "gemma-4-e4b-it": {
          "name": "Gemma 4 E4B (LM Studio)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 120000,
            "output": 8192
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "openai": {
      "options": {
        // "apiKey": "{env:OPENAI_API_KEY}",
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    },
    "kiro": {
      "npm": "kiro-acp-ai-provider",
      "name": "Kiro",
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5 (Kiro)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (Kiro)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "notion_*": "ask",
    "Sanity_*": "ask",
    "chrome-devtools_*": "ask",
    "context7_*": "ask",
    "github_*": "ask",
    "obsidian_*": "allow"
  },
  "mcp": {
    "aws-knowledge-mcp-server": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": false
    },
    // https://github.com/paulburgess1357/nvim-mcp
    "nvim-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "nvim-mcp"
      ],
      "enabled": false
    },
    "calculator": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "peva-calculator-mcp:latest"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "confluence": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "--env",
        "CONFLUENCE_DEFAULT_SPACE={env:CONFLUENCE_DEFAULT_SPACE}",
        "--env",
        "CONFLUENCE_BASE_URL={env:CONFLUENCE_BASE_URL}",
        "--env",
        "CONFLUENCE_TOKEN={env:CONFLUENCE_TOKEN}",
        "--env",
        "CONFLUENCE_ALLOW_MUTATIONS=true",
        "peva-atlassian-mcp:latest"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "peva-fetch-mcp:latest"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    },
    // This plugin is extremely dangerous to use
    // grep.app does not sort searces in any curated/popular/etc. way
    // last time i checked searching for "svelte" only gave real svelte docs at result #11
    // It will output ANY code snippets, including obvious LLM injection traps (result #4 when looking for svelte)
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "jira": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "--env",
        "JIRA_ALLOW_MUTATIONS=true",
        "--env",
        "JIRA_BASE_URL={env:JIRA_BASE_URL}",
        "--env",
        "JIRA_TOKEN={env:JIRA_TOKEN}",
        "peva-jira-mcp:latest"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-knowledge-graph",
        "--memory-path",
        "{env:AIM_GLOBAL_PATH}"
      ],
      "enabled": false
    },
    "notion": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--env",
        "NOTION_TOKEN={env:NOTION_API_TOKEN}",
        "peva-notion-mcp:latest"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "sanity": {
      "type": "remote",
      "url": "https://mcp.sanity.io",
      "headers": {
        "Authorization": "Bearer {env:SANITY_MCP_TOKEN}"
      },
      "enabled": false
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "peva-sequentialthinking-mcp:latest"
      ]
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": false
    },
    "obsidian": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "--env",
        "OBSIDIAN_API_KEY={env:OBSIDIAN_API_KEY}",
        "peva-obsidian-mcp:latest"
      ],
      "enabled": false
    },
    "time": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "--rm",
        "-i",
        "peva-time-mcp:latest"
      ],
      "enabled": true
    },
    "agentmemory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp@0.9.27"
      ],
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      },
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts",
  ]
}
